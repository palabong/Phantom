# phantom_cloud local / production environment template
# Copy to .env and populate. Do not commit .env.

# Server
PORT=8000

# Authentication (Unkey v2)
# When UNKEY_ROOT_KEY is set, every token is verified against Unkey v2.
# When UNKEY_ROOT_KEY is unset, the service accepts any token starting with "ph_live_".
UNKEY_ROOT_KEY=
UNKEY_API_ID=

# Client token example (the value sent as ?token= on /sse/)
# TOKEN=D2aZuYtdGL6tUfuV2egoxp
